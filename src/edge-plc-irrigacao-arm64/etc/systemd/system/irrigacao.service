[Unit]
Description=Serviço de controle de irrigação
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User = root
ExecStart=/opt/edge-plc/irrigacao
WorkingDirectory=/opt/edge-plc
Restart=on-failure
StartLimitIntervalSec=120
StartLimitBurst=10
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
