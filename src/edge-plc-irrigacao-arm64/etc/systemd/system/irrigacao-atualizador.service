[Unit]
Description=Serviço de Atualização do software de irrigação
After=network.target

[Service]
Type=simple
User = root
ExecStart=/opt/edge-plc/irrigacao-atualizador
WorkingDirectory=/opt/edge-plc
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
