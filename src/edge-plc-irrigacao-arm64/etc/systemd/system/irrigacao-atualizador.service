[Unit]
Description=Serviço de Atualização do software de irrigação
After=network.target

[Service]
Type=simple
ExecStart=/opt/edge-plc/irrigacao-atualizador
WorkingDirectory=/opt/edge-plc
Restart=always
RestartSec=2s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
