[Unit]
Description=Serviço de Atualização do software de irrigação
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=10


[Service]
Type=simple
ExecStart=/opt/edge-plc/irrigacao-atualizador
WorkingDirectory=/opt/edge-plc
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
